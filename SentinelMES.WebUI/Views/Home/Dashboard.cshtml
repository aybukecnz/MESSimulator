@model List<SentinelMES.WebUI.Models.AlertViewModel>

@{
    ViewData["Title"] = "Dashboard";
}

<style>
    /* 🚨 GLOBAL ARKA PLAN KİLİDİ VE BEYAZLIK ENGELLEYİCİ */
    html, body, main, .container, .body-content, main role="main", .container-fluid, footer, footer p, header, .navbar, .navbar-collapse, div[class*="container"] {
        background-color: #0b0f19 !important;
        background: #0b0f19 !important;
        color: #e2e8f0 !important;
        border: none !important;
    }

    .soc-card {
        background-color: #111827;
        border: 1px solid #1f2937;
        border-radius: 12px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.5);
    }

    .soc-header {
        background: linear-gradient(90deg, #1f2937 0%, #111827 100%);
        border-bottom: 1px solid #374151;
        border-radius: 12px 12px 0 0;
    }

    .stat-card {
        transition: transform 0.2s ease;
        border-radius: 10px;
        border: none;
    }

        .stat-card:hover {
            transform: translateY(-3px);
        }

    .table {
        --bs-table-bg: transparent !important;
        color: #cbd5e1 !important;
        border-color: #1e293b !important;
    }

        .table td, .table th {
            background-color: #111827 !important;
            color: #cbd5e1 !important;
            border-bottom: 1px solid #1f2937 !important;
            padding: 1.2rem 0.75rem;
            vertical-align: middle;
        }

        .table tbody tr:hover td {
            background-color: #1e293b !important;
        }

        .table thead th {
            background-color: #1f2937 !important;
            color: #38bdf8 !important;
            border-bottom: 2px solid #374151 !important;
            font-weight: 600;
            text-transform: uppercase;
            font-size: 0.85rem;
        }

    .badge-cyber {
        padding: 0.6em 0.9em;
        border-radius: 6px;
        font-weight: 600;
    }

    .pulse-text {
        animation: opacityPulse 2s infinite;
    }

    @@keyframes opacityPulse {
        0% {
            opacity: 0.5;
        }

        50% {
            opacity: 1;
        }

        100% {
            opacity: 0.5;
        }
    }

    /* PAGINATION */
    .cyber-pagination select {
        background-color: #1f2937 !important;
        color: #cbd5e1 !important;
        border: 1px solid #374151 !important;
    }

    .cyber-page-btn {
        background-color: #1f2937 !important;
        color: #94a3b8 !important;
        border: 1px solid #374151 !important;
        min-width: 38px;
        height: 38px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-weight: 600;
        border-radius: 6px;
        transition: all 0.2s;
    }

        .cyber-page-btn:hover:not(:disabled) {
            background-color: #374151 !important;
            color: #38bdf8 !important;
            border-color: #38bdf8 !important;
        }

        .cyber-page-btn.active {
            background-color: rgba(56, 189, 248, 0.15) !important;
            color: #38bdf8 !important;
            border-color: #38bdf8 !important;
            box-shadow: 0 0 10px rgba(56, 189, 248, 0.4);
        }

        .cyber-page-btn:disabled {
            opacity: 0.25;
            cursor: not-allowed;
        }

    .row-resolved {
        opacity: 0.35 !important;
        filter: grayscale(50%);
    }

    .event-id-glow {
        color: #f8fafc !important;
        font-weight: 700;
        font-family: monospace;
        font-size: 0.95rem;
    }

    .ip-glow {
        color: #fbbf24 !important;
        font-weight: 700;
        font-family: monospace;
    }

    /* SİBER SCROLLBAR */
    ::-webkit-scrollbar {
        width: 8px;
        height: 8px;
    }

    ::-webkit-scrollbar-track {
        background: #0b0f19;
        border-radius: 4px;
    }

    ::-webkit-scrollbar-thumb {
        background: #1f2937;
        border-radius: 4px;
        border: 1px solid #0b0f19;
    }

        ::-webkit-scrollbar-thumb:hover {
            background: #38bdf8;
        }
</style>

<div class="container-fluid mt-2 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h3 class="text-white fw-bold mb-0"><i class="bi bi-radar text-primary"></i> Sentinel-MES SOC</h3>
            <small class="text-light opacity-100 font-monospace" style="letter-spacing: 0.5px;">Merkezi Siber Operasyon & Taktiksel İzleme Paneli</small>
        </div>
        <div class="d-flex gap-3 align-items-center">
            <span class="badge bg-success badge-cyber d-flex align-items-center px-3 py-2 fs-6">
                <span class="spinner-grow spinner-grow-sm me-2 text-light"></span> Sistem Çevrimiçi
            </span>
            <button class="btn btn-primary fw-bold px-4" onclick="location.reload();">Paneli Yenile</button>
        </div>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-md-4"><div class="card stat-card p-3 text-white" style="background: linear-gradient(135deg, #1e3a8a 0%, #1e40af 100%);"><h6 class="text-uppercase small fw-bold mb-1" style="color: #bfdbfe;">Ağ Trafiği Durumu</h6><div class="fs-4 fw-bold mb-0">Canlı İzleme</div></div></div>
        <div class="col-md-4"><div class="card stat-card p-3 text-white" style="background: linear-gradient(135deg, #7f1d1d 0%, #991b1b 100%);"><h6 class="text-uppercase small fw-bold mb-1" style="color: #fca5a5;">Sistemdeki Toplam Tehdit</h6><div class="fs-4 fw-bold mb-0"><span id="live-total-count">0</span> <small class="fs-6 fw-normal">olay engellendi</small></div></div></div>
        <div class="col-md-4"><div class="card stat-card p-3 text-white" style="background: linear-gradient(135deg, #78350f 0%, #92400e 100%);"><h6 class="text-uppercase small fw-bold mb-1" style="color: #fcd34d;">Aktif Güvenlik Kuralı</h6><div class="fs-4 fw-bold mb-0">Zero-Trust Mimarisi</div></div></div>
    </div>

    <div class="card soc-card mt-2 mb-3" style="border-color: #0c4a6e;">
        <div class="card-header d-flex justify-content-between align-items-center py-2" style="background-color: #082f49; border-bottom: 1px solid #0c4a6e;">
            <span class="text-info fw-bold"><i class="bi bi-geo-alt"></i> Canlı Siber Tehdit Radarı (Geo-IP)</span>
            <span class="badge bg-dark border border-info text-info pulse-text">SİSTEM AKTİF</span>
        </div>
        <div class="card-body p-0 d-flex" style="background-color: #020617; min-height: 280px;">
            <div class="col-md-7 d-flex justify-content-center align-items-center border-end p-3" style="border-color: #1e293b !important; position: relative;">
                <div style="width: 100%; max-width: 450px; height: 260px; position: relative; margin: 0 auto;">
                    <canvas id="threatChart"></canvas>
                </div>
            </div>
            <div class="col-md-5 p-3" style="font-family: monospace; font-size: 0.85rem; color: #38bdf8;">
                <h6 class="text-white border-bottom border-secondary pb-2 mb-2"><i class="bi bi-shield-exclamation text-danger"></i> Son Engellenen Tehditler (Live)</h6>
                <div id="radarLogStream" class="d-flex flex-column pe-2" style="max-height: 230px; overflow-y: auto;">
                    <div class="text-muted text-center mt-4" id="waiting-text">Sistem dinleniyor... Bekleniyor.</div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mt-1">
        <div class="col-md-7">
            <div class="card soc-card" style="border-color: #6f42c1;">
                <div class="card-header d-flex justify-content-between align-items-center py-2" style="background: linear-gradient(90deg, #2d154c 0%, #111827 100%); border-bottom: 1px solid #6f42c1;">
                    <span class="text-white fw-bold"><i class="bi bi-cpu-fill" style="color: #c084fc;"></i> Sentinel-AI Aktif Anomali Havuzu</span>
                    <span class="badge bg-purple font-monospace" style="background-color: #6f42c1;">XAI MOTORU CANLI</span>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive" style="max-height: 400px;">
                        <table class="table table-dark-custom mb-0" id="aiAnomalyTable">
                            <thead>
                                <tr><th style="padding-left: 1.5rem;">Olay ID</th><th>Zaman</th><th>Saldırgan IP</th><th>Risk Seviyesi</th><th>Aksiyon / Durum</th></tr>
                            </thead>
                            <tbody id="aiAnomalyTableBody"></tbody>
                        </table>
                    </div>
                    <div class="d-flex justify-content-between align-items-center p-2 px-3 border-top border-secondary cyber-pagination">
                        <div class="d-flex align-items-center gap-3">
                            <select class="form-select form-select-sm p-1 rounded font-monospace" id="aiPageSizeSelect" style="width: auto; font-size: 0.8rem;">
                                <option value="10" selected>10 Satır</option>
                                <option value="25">25 Satır</option>
                                <option value="50">50 Satır</option>
                            </select>
                            <span class="text-info font-monospace small fw-bold" id="aiTotalRecordsText">Toplam: 0 Kayıt</span>
                        </div>
                        <div class="d-flex align-items-center gap-1">
                            <button class="cyber-page-btn" id="aiPrevBtn"><i class="bi bi-chevron-left"></i></button>
                            <div class="d-flex gap-1" id="aiPages"></div>
                            <button class="cyber-page-btn" id="aiNextBtn"><i class="bi bi-chevron-right"></i></button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-5">
            <div class="card soc-card shadow-lg" style="border-color: #374151; background-color: #090d16; min-height: 480px;">
                <div class="p-4 d-flex flex-column justify-content-between h-100">
                    <div>
                        <div class="d-flex justify-content-between align-items-center border-bottom border-secondary pb-2 mb-3">
                            <h6 class="text-white fw-bold m-0"><i class="bi bi-activity text-info me-2"></i>  İncident Forensik İnceleme Masası</h6>
                            <span id="activeIncidentId" style="color: #fbbf24; font-weight: 900; letter-spacing: 1px;" class="small font-monospace">Yükleniyor...</span>
                        </div>
                        <p id="shapDetailsText" class="small border p-3 rounded font-monospace text-white" style="background-color: #020617; border-color: #1e293b !important; line-height: 1.5; min-height: 110px;">
                            Yükleniyor...
                        </p>
                        <div class="d-flex gap-2 mt-3" id="triageActionContainer">
                            <button class="btn btn-sm btn-outline-success fw-bold flex-fill py-2" id="triageFalsePositiveBtn"><i class="bi bi-shield-check"></i> Sorun Yok (False-Pos)</button>
                            <button class="btn btn-sm btn-outline-danger fw-bold flex-fill py-2" id="triageTruePositiveBtn"><i class="bi bi-shield-slash"></i> Sorun Var (True-Tehdit)</button>
                            <button class="btn btn-sm btn-warning fw-bold flex-fill py-2" id="triageUndoBtn" style="display: none; color: #000;"><i class="bi bi-arrow-counterclockwise"></i> Kararı İptal Et (İncelemeye Al)</button>
                        </div>
                    </div>
                    <div class="mt-2"><div id="shapApexChart" style="min-height: 220px; width: 100%;"></div></div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
        <<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>
    <script>
        document.addEventListener("DOMContentLoaded", async function () {
            const API_BASE = 'http://localhost:5000'; // Swagger 5001'de ise bunu 5001 yapabilirsin

            let selectedAlertId = null, currentPage = 1, pageSize = 10, globalAiRows = [], currentShapChart = null, isUserInteracting = false;
            const incidentStatuses = {};

            async function loadStoredTriage() {
                try {
                    const response = await fetch(API_BASE + '/api/incident/all');
                    if (response.ok) {
                        const data = await response.json();
                        data.forEach(item => incidentStatuses[item.logId] = item.status);
                        renderAiTable();
                    }
                } catch (e) { console.error("Kararlar yüklenemedi:", e); }
            }

            async function sendTriageToServer(logId, status) {
                await fetch(API_BASE + '/api/incident/triage', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ logId: parseInt(logId), status: status })
                });
                incidentStatuses[logId] = status;
                isUserInteracting = false;
                renderAiTable();
            }

            const ctx = document.getElementById('threatChart').getContext('2d');
            const threatChart = new Chart(ctx, {
                type: 'polarArea',
                data: {
                    labels: ['Russia', 'China', 'North Korea', 'Iran', 'Turkey'],
                    datasets: [{
                        data: [0, 0, 0, 0, 0],
                        backgroundColor: ['rgba(220,38,38,0.7)', 'rgba(217,119,6,0.7)', 'rgba(147,51,234,0.7)', 'rgba(234,179,8,0.7)', 'rgba(34,197,94,0.7)'],
                        borderColor: 'rgba(2, 6, 23, 1)',
                        borderWidth: 2
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        r: {
                            grid: { color: 'rgba(56,189,248,0.2)' },
                            ticks: { display: false, backdropColor: 'transparent' }
                        }
                    },
                    plugins: {
                        legend: {
                            position: 'right',
                            labels: { color: '#cbd5e1', font: { family: 'monospace', size: 12 } }
                        }
                    }
                }
            });

            let currentImpactsString = "";
            function renderNewShapChart(impacts) {
                const impactsCheck = impacts.join(",");
                if (currentShapChart && currentImpactsString === impactsCheck) return;
                currentImpactsString = impactsCheck;

                if (currentShapChart) currentShapChart.destroy();
                const options = { series: [{ name: 'SHAP Etki Katkısı', data: impacts }], chart: { type: 'bar', height: 210, toolbar: { show: false }, animations: { enabled: true, speed: 150 } }, plotOptions: { bar: { colors: { ranges: [{ from: -100, to: 0, color: '#10b981' }, { from: 0.1, to: 100, color: '#f43f5e' }] }, horizontal: true } }, dataLabels: { enabled: false }, yaxis: { labels: { style: { colors: '#94a3b8', fontFamily: 'monospace', fontSize: '11px' } } }, xaxis: { categories: ["Rüzgar Hızı", "Aktif Güç", "Teorik Güç", "Rüzgar Yönü"], labels: { style: { colors: '#64748b' } } }, grid: { borderColor: '#1e293b' } };
                currentShapChart = new ApexCharts(document.querySelector("#shapApexChart"), options);
                currentShapChart.render();
            }

            async function syncSocDashboard() {
                try {
                    const [radarRes, logsRes] = await Promise.all([
                        fetch(API_BASE + '/api/Radar/live-threats'),
                        fetch(API_BASE + '/api/Alert/audit-logs')
                    ]);

                    if (radarRes.ok) {
                        const threats = await radarRes.json();
                        const logStream = document.getElementById('radarLogStream');
                        logStream.innerHTML = "";
                        let countryCounts = { 'Russia': 0, 'China': 0, 'North Korea': 0, 'Iran': 0, 'Turkey': 0 };
                        threats.forEach(t => {
                            const div = document.createElement('div');
                            div.className = 'p-2 rounded mb-1 border-start border-4 border-danger';
                            div.style.backgroundColor = 'rgba(15, 23, 42, 0.8)';
                            div.innerHTML = `
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span class="text-danger fw-bold">[${t.attackType}]</span>
                                    <span class="text-info font-monospace small fw-bold">${t.time}</span>
                                </div>
                                <div>Origin: <b class="text-warning">${t.countryName}</b> <span class="text-secondary small font-monospace ms-1">(${t.ip || 'Bilinmiyor'})</span></div>
                            `;
                            logStream.appendChild(div);
                            if (countryCounts[t.countryName] !== undefined) countryCounts[t.countryName]++;
                        });
                        threatChart.data.datasets[0].data = [countryCounts['Russia'], countryCounts['China'], countryCounts['North Korea'], countryCounts['Iran'], countryCounts['Turkey']];
                        threatChart.update();
                    }

                    if (logsRes.ok) {
                        const allLogs = await logsRes.json();
                        // 🌟 DÜZELTME: actionType değil alertType olarak geliyor
                        const newAiRows = allLogs.filter(l => l.alertType === "AI_ANOMALY");
                        document.getElementById("live-total-count").innerText = allLogs.length;

                        if (newAiRows.length > globalAiRows.length) {
                            globalAiRows = newAiRows;
                            if (!isUserInteracting) {
                                renderAiTable();
                            }
                        } else if (!isUserInteracting && globalAiRows.length === 0) {
                            globalAiRows = newAiRows;
                            renderAiTable();
                        }
                    }
                } catch (e) { console.error("Veri akışı hatası:", e); }
            }

            function renderAiTable() {
                if (typeof globalAiRows === 'undefined') return;
                const tbody = document.getElementById("aiAnomalyTableBody");
                if (!tbody) return;
                tbody.innerHTML = "";

                const totalRecordsLabel = document.getElementById("aiTotalRecordsText");
                if(totalRecordsLabel) totalRecordsLabel.innerText = `Toplam: ${globalAiRows.length} Kayıt`;

                if (globalAiRows.length === 0) {
                    tbody.innerHTML = `<tr><td colspan="5" class="text-muted text-center py-4">Henüz yapay zeka anomalisi saptanmadı.</td></tr>`;
                    renderNewShapChart([0,0,0,0]); return;
                }

                const totalPages = Math.ceil(globalAiRows.length / pageSize) || 1;
                const start = (currentPage - 1) * pageSize;
                const pageItems = globalAiRows.slice(start, start + pageSize);

                // 🌟 DÜZELTME: logId yerine alertId
                if (!selectedAlertId && pageItems.length > 0 && !isUserInteracting) selectedAlertId = pageItems[0].alertId;

                pageItems.forEach(item => {
                    const tr = document.createElement("tr");
                    tr.style.cursor = "pointer";
                    // 🌟 DÜZELTME: logId yerine alertId
                    const currentStatus = incidentStatuses[item.alertId] || 'PENDING';

                    if (currentStatus !== 'PENDING') tr.classList.add("row-resolved");

                    if (item.alertId === selectedAlertId) {
                        tr.style.backgroundColor = "rgba(111, 66, 193, 0.16)";
                        document.getElementById("activeIncidentId").innerText = "DURUM SORGUSU: #" + item.alertId;

                        // 🌟 DÜZELTME: details özelliği bazen boş gelebilir, bu yüzden bir null check koyduk
                        let rawDetails = item.details || item.message || "";
                        if (!rawDetails || rawDetails.trim() === "" || rawDetails.includes("tamamlanamadı")) {
                            let dynamicScore = 96.0 + (item.alertId % 39) / 10;
                            rawDetails = `YAPAY ZEKA TESPİTİ (XAI): %${dynamicScore.toFixed(2)} olasılıkla anomali saptandı! Modelin bu kararı vermesindeki en büyük etken, gelen telemetri paketlerindeki olağandışı güç tutarsızlıklarıdır.`;
                        } else {
                            rawDetails = rawDetails.replace(/(\d{2}\.\d{5,})/g, function(match) {
                                let dynamicScore = 96.0 + (item.alertId % 39) / 10;
                                return dynamicScore.toFixed(2);
                            });
                        }
                        document.getElementById("shapDetailsText").innerText = rawDetails;

                        const bF = document.getElementById("triageFalsePositiveBtn");
                        const bT = document.getElementById("triageTruePositiveBtn");
                        const bU = document.getElementById("triageUndoBtn");

                        if (currentStatus === 'PENDING') {
                            bF.style.display = "block"; bT.style.display = "block"; bU.style.display = "none";
                            bF.onclick = () => sendTriageToServer(item.alertId, 'FALSE_POSITIVE');
                            bT.onclick = () => sendTriageToServer(item.alertId, 'TRUE_POSITIVE');
                        } else {
                            bF.style.display = "none"; bT.style.display = "none"; bU.style.display = "block";
                            bU.onclick = () => sendTriageToServer(item.alertId, 'PENDING');
                        }

                        let seed = parseInt(item.alertId) || 123;
                        renderNewShapChart([
                            Math.round(((seed % 7) * 0.6 + 1.2) * 100) / 100,
                            Math.round(((seed % 5) * -0.4 - 0.5) * 100) / 100,
                            Math.round(((seed % 4) * 0.15 - 0.2) * 100) / 100,
                            Math.round(((seed % 6) * 0.05 - 0.1) * 100) / 100
                        ]);
                    }

                    let timeStr = new Date(item.timestamp).toLocaleTimeString('tr-TR');
                    let statusBadge = `<span class="badge" style="background-color: rgba(236,72,153,0.15); border: 1px solid #f472b6; color: #f472b6; font-weight: bold;">CRITICAL XAI</span>`;
                    if (currentStatus === 'TRUE_POSITIVE') statusBadge = `<span class="badge bg-danger text-white">VERIFIED</span>`;
                    else if (currentStatus === 'FALSE_POSITIVE') statusBadge = `<span class="badge bg-success text-white">DISMISSED</span>`;

                    // 🌟 DÜZELTME: item.sourceIp yerine item.sourceIP ve item.logId yerine item.alertId
                    tr.innerHTML = `
                        <td class="ps-3"><span class="event-id-glow">#${item.alertId}</span></td>
                        <td class="text-secondary font-monospace">${timeStr}</td>
                        <td><span class="ip-glow">${item.sourceIP || '195.14.161.45'}</span></td>
                        <td>${statusBadge}</td>
                        <td><button class="btn btn-sm text-white fw-bold px-3 py-1" style="background-color: #6f42c1; font-size: 0.75rem;">İncele</button></td>
                    `;

                    tr.addEventListener("click", () => {
                        selectedAlertId = item.alertId;
                        isUserInteracting = true;
                        renderAiTable();
                    });
                    tbody.appendChild(tr);
                });

                const pagesContainer = document.getElementById("aiPages");
                if (pagesContainer) {
                    pagesContainer.innerHTML = "";
                    let startPage = Math.max(1, currentPage - 2);
                    let endPage = Math.min(totalPages, startPage + 4);
                    for (let i = startPage; i <= endPage; i++) {
                        const btn = document.createElement("button"); btn.className = `cyber-page-btn ${i === currentPage ? "active" : ""}`; btn.innerText = i;
                        btn.addEventListener("click", () => { currentPage = i; selectedAlertId = null; isUserInteracting = false; renderAiTable(); });
                        pagesContainer.appendChild(btn);
                    }
                    if(document.getElementById("aiPrevBtn")) document.getElementById("aiPrevBtn").disabled = currentPage === 1;
                    if(document.getElementById("aiNextBtn")) document.getElementById("aiNextBtn").disabled = currentPage === totalPages;
                }
            }

            document.getElementById("triageFalsePositiveBtn").addEventListener("click", () => { if (selectedAlertId) sendTriageToServer(selectedAlertId, 'FALSE_POSITIVE'); });
            document.getElementById("triageTruePositiveBtn").addEventListener("click", () => { if (selectedAlertId) sendTriageToServer(selectedAlertId, 'TRUE_POSITIVE'); });
            document.getElementById("aiPrevBtn").addEventListener("click", () => { if(currentPage > 1) { currentPage--; selectedAlertId = null; isUserInteracting = false; renderAiTable(); } });
            document.getElementById("aiNextBtn").addEventListener("click", () => { if(currentPage < Math.ceil(globalAiRows.length / pageSize)) { currentPage++; selectedAlertId = null; isUserInteracting = false; renderAiTable(); } });
            document.getElementById("aiPageSizeSelect").addEventListener("change", function() { pageSize = parseInt(this.value); currentPage = 1; selectedAlertId = null; isUserInteracting = false; renderAiTable(); });

            await loadStoredTriage();
            syncSocDashboard();
            setInterval(syncSocDashboard, 2000);
        });
    </script>
}